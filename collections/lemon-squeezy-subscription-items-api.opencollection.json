                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the quantity of a quantity-based or usage-based subscription item."
        },
        {
          "info": {
            "name": "Retrieve a subscription item's current usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lemonsqueezy.com/v1/subscription-items/:id/current-usage",
            "params": [
