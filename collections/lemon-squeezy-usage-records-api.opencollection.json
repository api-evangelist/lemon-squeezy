{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lemon Squeezy Checkouts Usage Records API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage Records",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all usage records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lemonsqueezy.com/v1/usage-records",
            "params": [
              {
                "name": "filter[subscription_item_id]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all usage records"
        },
        {
          "info": {
            "name": "Create a usage record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lemonsqueezy.com/v1/usage-records",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Report usage for a usage-based subscription item."
        },
        {
          "info": {
            "name": "Retrieve a usage record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lemonsqueezy.com/v1/usage-records/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource ID."
              }
            ]
          },
          "docs": "Retrieve a usage record"
        }
      ]
    }
  ],
  "bundled": true
}